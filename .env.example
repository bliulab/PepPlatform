# Copy to .env, then fill in the three required secrets before Docker Compose startup.
# Generate each independently with: openssl rand -hex 32
# Use a URL-safe database password (hex is suitable for the database URL).
POSTGRES_PASSWORD=
PEP_SESSION_SECRET=
# Keep this value stable across restarts and backups to read saved AI API keys.
PEP_LLM_KEY_ENCRYPTION_SECRET=

PEP_ENV=production
PEP_AUTH_DEBUG_CODES=0
PEP_PUBLIC_BASE_URL=http://127.0.0.1:8080
PEP_HTTP_PORT=8080
# Unset: derive the cookie Secure flag from PEP_PUBLIC_BASE_URL (HTTPS -> true).
# PEP_COOKIE_SECURE=true

# Set both for first login without SMTP; otherwise configure SMTP and register.
# An existing account keeps its password on restart; this is not a password-reset switch.
PEP_INITIAL_ADMIN_EMAIL=
PEP_INITIAL_ADMIN_PASSWORD=

# Optional web search; leave the key empty when this integration is unused.
PEP_TAVILY_API_KEY=
PEP_WEB_SEARCH_ENABLED=true
PEP_TOP_NGRAM_MAX_RESIDUES=10000

# New Web dataset uploads only; positive integers, applied after backend restart.
# MiB = 1,048,576 bytes. The request body allows an extra 1 MiB for multipart fields.
PEP_DATASET_UPLOAD_MAX_ARCHIVE_MIB=64
PEP_DATASET_UPLOAD_MAX_EXTRACTED_MIB=512
PEP_DATASET_UPLOAD_MAX_FILE_MIB=256
PEP_DATASET_UPLOAD_MAX_ENTRIES=1000

# Outgoing mail is required for registration and password-reset codes.
PEP_SMTP_HOST=
PEP_SMTP_PORT=587
PEP_SMTP_USER=
PEP_SMTP_PASSWORD=
PEP_SMTP_FROM=
PEP_SMTP_SSL=auto
PEP_SMTP_STARTTLS=1
PEP_SMTP_TIMEOUT=15
# For QQ Mail, use smtp.qq.com and the mailbox authorization code as the password.
# The sender must match the authenticated mailbox. Port 465 selects implicit TLS.

# Default Docker profile: paper CUDA 12.1; requires NVIDIA Container Toolkit.
# CPU alternative: add -f docker-compose.yml -f docker-compose.cpu.yml to every command.
# Optional build download sources; versions and CPU/CUDA channels stay fixed.
PEP_PIP_INDEX_URL=https://pypi.org/simple
PEP_TORCH_INDEX_BASE_URL=https://download.pytorch.org/whl
PEP_PIP_TIMEOUT=120
# China examples (uncomment to select explicitly):
# PEP_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PEP_TORCH_INDEX_BASE_URL=https://mirrors.nju.edu.cn/pytorch/whl
# Pretrained downloads: use the official endpoint by default. A third-party mirror
# can be selected explicitly, e.g. HF_ENDPOINT=https://hf-mirror.com.
HF_ENDPOINT=https://huggingface.co
# Optional token, sent to the selected endpoint. Never commit a real token.
# HF_TOKEN=
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=20
# Set to 1 only if the selected endpoint does not support Xet downloads.
HF_HUB_DISABLE_XET=0
# Preparation-only compatibility for proxies failing modern TLS handshakes.
# 1 keeps certificate verification, caps HTTPS at TLS 1.2 and disables Xet.
PEP_HF_TLS12=0
# Enable both after importing/checking all six original paper checkpoints.
HF_HUB_OFFLINE=0
PEPPLATFORM_OFFLINE_MODE=0
# Local development without SMTP can use PEP_ENV=development and PEP_AUTH_DEBUG_CODES=1.

# Optional absolute subtrees excluded from model deletion (colon-separated on Linux).
# External files, datasets, and pretrained resources are always excluded.
# Docker users: pass this variable through a persistent Compose override too.
PEP_RETENTION_EXCLUDED_ROOTS=
