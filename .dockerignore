# Local runtime state and developer tooling
.agents/
.codex/
.external/
.opencode/
.pepplatform_web/
.pepplatform_versioned/
.playwright-cli/
.playwright-auth/

# Local model resources and development files are not part of the web image.
models/
output/
tests/
tools/

# The source distribution contains no bundled datasets. Keep only the runtime
# helper called by peptide-function profile generation.
!tools/
tools/*
!tools/build_sequence_profile_cache.py

# Export receipts and local verification outputs never enter images.
.export-audit/

# Deployment backups must remain on the host.
backup/
backup_*.sql

